# MiniMax API Key（使用 MiniMax M2.7 系列模型时需要）
OPENAI_API_KEY=${YOUR_MINIMAX_API_KEY}
# MiniMax API Base URL
OPENAI_BASE_URL=https://api.minimaxi.com/v1
BOCHA_API_KEY=              # 博查搜索 API Key，web_search 工具使用
SUBAGENT_MODEL=             # 低成本子模型名称；留空时不启用子任务分派
SUBAGENT_BASE_URL=          # 可选：子模型使用独立的 OpenAI 兼容 API 地址
SUBAGENT_API_KEY=           # 设置独立地址时必填；同一地址时复用主模型客户端
